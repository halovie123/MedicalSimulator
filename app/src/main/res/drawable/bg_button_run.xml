<?xml version="1.0" encoding="utf-8"?>
<!-- RUN (teal, mirrors bg_button_scan) → selected = STOP (red, mirrors bg_button_rec) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#286F68" />
            <stroke android:width="1dp" android:color="#76F0DB" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A252C" />
            <stroke android:width="1dp" android:color="@color/status_disconnected" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#172229" />
            <stroke android:width="1dp" android:color="#2A424A" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_scan_bg" />
            <stroke android:width="1dp" android:color="#286F68" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
