<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#63323C" />
            <stroke android:width="1dp" android:color="#FF9B9B" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A252C" />
            <stroke android:width="1dp" android:color="@color/status_disconnected" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_disconnect_bg" />
            <stroke android:width="1dp" android:color="#63323C" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
