<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F4A49" />
            <stroke android:width="1.5dp" android:color="#55E8D2" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A343B" />
            <stroke android:width="1dp" android:color="#55B9AE" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Default (unselected) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#172229" />
            <stroke android:width="1dp" android:color="#2A424A" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
