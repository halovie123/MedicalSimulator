<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#001A00" />
            <stroke android:width="1.5dp" android:color="#00FF88" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D2200" />
            <stroke android:width="1dp" android:color="#00AA55" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Default (unselected) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#030800" />
            <stroke android:width="1dp" android:color="#091900" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
