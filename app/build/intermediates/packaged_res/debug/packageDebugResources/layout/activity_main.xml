<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary"
    android:keepScreenOn="true"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/status_bar_horizontal_padding"
        android:paddingEnd="@dimen/status_bar_horizontal_padding"
        android:background="@drawable/bg_status_bar">

        <View
            android:id="@+id/statusDot"
            android:layout_width="@dimen/status_dot_size"
            android:layout_height="@dimen/status_dot_size"
            android:background="@drawable/ic_dot_disconnected" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/disconnected"
            android:textColor="@color/status_disconnected"
            android:textSize="@dimen/status_text_size"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monitor_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/header_title_size"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_device"
                android:textColor="@color/text_device_name"
                android:textSize="@dimen/device_name_size"
                android:fontFamily="sans-serif"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="@string/unit_title"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/eyebrow_text_size"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnScan"
            style="@style/ButtonStyle.ActionButton"
            android:layout_width="@dimen/scan_button_width"
            android:layout_height="@dimen/action_button_height"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/btn_scan"
            android:background="@drawable/bg_button_scan"
            android:textColor="@color/button_scan_text" />

        <Button
            android:id="@+id/btnDisconnect"
            style="@style/ButtonStyle.ActionButton"
            android:layout_width="@dimen/disconnect_button_width"
            android:layout_height="@dimen/action_button_height"
            android:text="@string/btn_disconnect"
            android:background="@drawable/bg_button_disconnect"
            android:textColor="@color/button_disconnect_text"
            android:enabled="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_waveform_panel"
            android:padding="@dimen/waveform_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_md"
                android:elevation="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_waveform"
                    android:textColor="@color/waveform_label"
                    android:textSize="@dimen/eyebrow_text_size"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true" />
                <TextView
                    android:id="@+id/tvRecIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="@string/rec_indicator"
                    android:textColor="@color/status_disconnected"
                    android:textSize="@dimen/eyebrow_text_size"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvPlaybackIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="@string/playback_indicator"
                    android:textColor="@color/waveform_green"
                    android:textSize="@dimen/eyebrow_text_size"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/btnRec"
                    style="@style/ButtonStyle.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/action_button_height"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:text="@string/btn_rec"
                    android:background="@drawable/bg_button_rec"
                    android:textColor="@color/button_disconnect_text" />
                <Button
                    android:id="@+id/btnPlay"
                    style="@style/ButtonStyle.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/action_button_height"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:text="@string/btn_play"
                    android:background="@drawable/bg_button_scan"
                    android:textColor="@color/button_scan_text" />
                <Button
                    android:id="@+id/btnStopPlayback"
                    style="@style/ButtonStyle.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/action_button_height"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:text="@string/btn_stop"
                    android:background="@drawable/bg_button_disconnect"
                    android:textColor="@color/button_disconnect_text"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hz_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/eyebrow_text_size"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <com.medical.simulator.ui.WaveformSurfaceView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <include
            layout="@layout/metric_grid"
            android:layout_width="@dimen/metric_panel_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_sm" />
    </LinearLayout>

    <include
        layout="@layout/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
