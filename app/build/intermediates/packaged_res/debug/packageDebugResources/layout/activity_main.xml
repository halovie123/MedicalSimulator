<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary"
    android:keepScreenOn="true">

    <!-- ════════════════════ STATUS BAR ════════════════════ -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_status_bar">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/ic_dot_disconnected" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/disconnected"
            android:textColor="@color/status_disconnected"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/no_device"
            android:textColor="@color/text_device_name"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="PPG SIMULATOR"
            android:textColor="#1A3300"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-condensed" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_scan"
            android:background="@drawable/bg_button_scan"
            android:textColor="@color/button_scan_text"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-condensed" />

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="110dp"
            android:layout_height="34dp"
            android:text="@string/btn_disconnect"
            android:background="@drawable/bg_button_disconnect"
            android:textColor="@color/button_disconnect_text"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-condensed"
            android:enabled="false" />

    </LinearLayout>

    <!-- ════════════════ METRICS + WAVEFORM ════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Left metric cards -->
        <LinearLayout
            android:layout_width="94dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <!-- HR card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginBottom="3dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card_metric" android:padding="4dp">
                <TextView style="@style/TextStyle.MetricLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_hr" />
                <TextView android:id="@+id/tvHrValue" style="@style/TextStyle.MetricValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="---" android:textColor="@color/metric_hr" />
                <TextView style="@style/TextStyle.MetricUnit"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/unit_bpm" />
            </LinearLayout>

            <!-- SpO2 card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginBottom="3dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card_metric" android:padding="4dp">
                <TextView style="@style/TextStyle.MetricLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_spo2" />
                <TextView android:id="@+id/tvSpo2Value" style="@style/TextStyle.MetricValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="---" android:textColor="@color/metric_spo2" />
                <TextView style="@style/TextStyle.MetricUnit"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/unit_percent" />
            </LinearLayout>

            <!-- RR card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginBottom="3dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card_metric" android:padding="4dp">
                <TextView style="@style/TextStyle.MetricLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_rr" />
                <TextView android:id="@+id/tvRrValue" style="@style/TextStyle.MetricValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="---" android:textColor="@color/metric_rr" />
                <TextView style="@style/TextStyle.MetricUnit"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/unit_rpm" />
            </LinearLayout>

            <!-- PI card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginBottom="3dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card_metric" android:padding="4dp">
                <TextView style="@style/TextStyle.MetricLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_pi" />
                <TextView android:id="@+id/tvPiValue" style="@style/TextStyle.MetricValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="---" android:textColor="@color/metric_pi"
                    android:textSize="20sp" />
                <TextView style="@style/TextStyle.MetricUnit"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/unit_pi" />
            </LinearLayout>

            <!-- Noise card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginBottom="3dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card_metric" android:padding="4dp">
                <TextView style="@style/TextStyle.MetricLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_noise" />
                <TextView android:id="@+id/tvNoiseValue" style="@style/TextStyle.MetricValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="---" android:textColor="@color/metric_noise"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Mode card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_card_metric" android:padding="4dp">
                <TextView style="@style/TextStyle.MetricLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_mode" />
                <TextView android:id="@+id/tvModeValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Normal"
                    android:textColor="@color/metric_mode"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-condensed"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />
            </LinearLayout>

        </LinearLayout>

        <!-- Waveform SurfaceView -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_waveform_panel"
            android:padding="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:text="PPG"
                android:textColor="#1A4D00"
                android:textSize="10sp"
                android:letterSpacing="0.20"
                android:fontFamily="sans-serif-condensed"
                android:textAllCaps="true"
                android:elevation="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:text="50 Hz"
                android:textColor="#1A4D00"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:elevation="2dp" />

            <com.medical.simulator.ui.WaveformSurfaceView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </LinearLayout>

    <!-- ════════════════ CONTROL PANEL ════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_control_panel"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- Two-column slider area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- LEFT: HR, SpO2, RR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="10dp">

                <!-- HR -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">
                    <TextView style="@style/TextStyle.ParamLabel"
                        android:layout_width="58dp" android:layout_height="wrap_content"
                        android:text="@string/param_hr" />
                    <Button android:id="@+id/btnHrDec" style="@style/ButtonStyle.IncrDecr"
                        android:text="−" android:layout_marginEnd="4dp" />
                    <SeekBar android:id="@+id/seekHr"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:thumb="@drawable/seekbar_thumb" android:splitTrack="false" />
                    <Button android:id="@+id/btnHrInc" style="@style/ButtonStyle.IncrDecr"
                        android:text="+" android:layout_marginStart="4dp" />
                    <TextView android:id="@+id/tvHrCurrent" style="@style/TextStyle.ParamValue"
                        android:layout_width="52dp" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:text="75" />
                </LinearLayout>

                <!-- SpO2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">
                    <TextView style="@style/TextStyle.ParamLabel"
                        android:layout_width="58dp" android:layout_height="wrap_content"
                        android:text="@string/param_spo2" />
                    <Button android:id="@+id/btnSpo2Dec" style="@style/ButtonStyle.IncrDecr"
                        android:text="−" android:layout_marginEnd="4dp" />
                    <SeekBar android:id="@+id/seekSpo2"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:thumb="@drawable/seekbar_thumb" android:splitTrack="false" />
                    <Button android:id="@+id/btnSpo2Inc" style="@style/ButtonStyle.IncrDecr"
                        android:text="+" android:layout_marginStart="4dp" />
                    <TextView android:id="@+id/tvSpo2Current" style="@style/TextStyle.ParamValue"
                        android:layout_width="52dp" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:text="98" />
                </LinearLayout>

                <!-- RR -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/TextStyle.ParamLabel"
                        android:layout_width="58dp" android:layout_height="wrap_content"
                        android:text="@string/param_rr" />
                    <Button android:id="@+id/btnRrDec" style="@style/ButtonStyle.IncrDecr"
                        android:text="−" android:layout_marginEnd="4dp" />
                    <SeekBar android:id="@+id/seekRr"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:thumb="@drawable/seekbar_thumb" android:splitTrack="false" />
                    <Button android:id="@+id/btnRrInc" style="@style/ButtonStyle.IncrDecr"
                        android:text="+" android:layout_marginStart="4dp" />
                    <TextView android:id="@+id/tvRrCurrent" style="@style/TextStyle.ParamValue"
                        android:layout_width="52dp" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:text="16" />
                </LinearLayout>

            </LinearLayout>

            <!-- Column divider -->
            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="@color/divider"
                android:layout_marginTop="2dp" android:layout_marginBottom="2dp" />

            <!-- RIGHT: PI, Noise -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <!-- PI -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">
                    <TextView style="@style/TextStyle.ParamLabel"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:text="@string/param_pi" />
                    <Button android:id="@+id/btnPiDec" style="@style/ButtonStyle.IncrDecr"
                        android:text="−" android:layout_marginEnd="4dp" />
                    <SeekBar android:id="@+id/seekPi"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:thumb="@drawable/seekbar_thumb" android:splitTrack="false" />
                    <Button android:id="@+id/btnPiInc" style="@style/ButtonStyle.IncrDecr"
                        android:text="+" android:layout_marginStart="4dp" />
                    <TextView android:id="@+id/tvPiCurrent" style="@style/TextStyle.ParamValue"
                        android:layout_width="52dp" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:text="2.50" />
                </LinearLayout>

                <!-- Noise -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/TextStyle.ParamLabel"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:text="@string/param_noise" />
                    <Button android:id="@+id/btnNoiseDec" style="@style/ButtonStyle.IncrDecr"
                        android:text="−" android:layout_marginEnd="4dp" />
                    <SeekBar android:id="@+id/seekNoise"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:thumb="@drawable/seekbar_thumb" android:splitTrack="false" />
                    <Button android:id="@+id/btnNoiseInc" style="@style/ButtonStyle.IncrDecr"
                        android:text="+" android:layout_marginStart="4dp" />
                    <TextView android:id="@+id/tvNoiseCurrent" style="@style/TextStyle.ParamValue"
                        android:layout_width="52dp" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:text="0.10" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
            android:background="@color/divider" />

        <!-- Condition mode buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE"
                android:textColor="@color/metric_label"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:layout_marginEnd="6dp" />

            <Button android:id="@+id/btnModeNormal"
                style="@style/ButtonStyle.ConditionMode"
                android:text="@string/mode_normal"
                android:textColor="@color/mode_normal"
                android:alpha="1.0" />

            <Button android:id="@+id/btnModeArrhythmia"
                style="@style/ButtonStyle.ConditionMode"
                android:text="@string/mode_arrhythmia"
                android:textColor="@color/mode_arrhythmia"
                android:alpha="0.45" />

            <Button android:id="@+id/btnModeWeakPerf"
                style="@style/ButtonStyle.ConditionMode"
                android:text="@string/mode_weak_perf"
                android:textColor="@color/mode_weak_perf"
                android:alpha="0.45" />

            <Button android:id="@+id/btnModeVasoconstric"
                style="@style/ButtonStyle.ConditionMode"
                android:text="@string/mode_vasoconstric"
                android:textColor="@color/mode_vasoconstric"
                android:alpha="0.45" />

            <Button android:id="@+id/btnModeStrongPerf"
                style="@style/ButtonStyle.ConditionMode"
                android:text="@string/mode_strong_perf"
                android:textColor="@color/mode_strong_perf"
                android:alpha="0.45" />

            <Button android:id="@+id/btnModeVasodilation"
                style="@style/ButtonStyle.ConditionMode"
                android:text="@string/mode_vasodilation"
                android:textColor="@color/mode_vasodilation"
                android:alpha="0.45" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
