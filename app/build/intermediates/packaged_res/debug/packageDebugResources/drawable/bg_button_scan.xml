<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#005522" />
            <stroke android:width="1dp" android:color="#00FF88" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#030800" />
            <stroke android:width="1dp" android:color="#0A1900" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_scan_bg" />
            <stroke android:width="1dp" android:color="#005522" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
