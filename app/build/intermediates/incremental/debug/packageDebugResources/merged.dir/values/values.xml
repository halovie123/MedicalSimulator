    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
</style>
    <style name="ButtonStyle.ActionButton">
        <item name="android:layout_height">38dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
    <style name="ButtonStyle.ConditionMode" parent="ButtonStyle">
        <item name="android:layout_width">0dp</item> <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_button_mode</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:padding">4dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
    </style>
    <style name="ButtonStyle.IncrDecr">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_button_incr_decr</item>
        <item name="android:textColor">@color/button_incr_decr_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="TextStyle" parent="android:Widget.TextView">
</style>
    <style name="TextStyle.MetricLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/metric_label</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextStyle.MetricUnit">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/metric_unit</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="TextStyle.MetricValue">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextStyle.ParamLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
    </style>
    <style name="TextStyle.ParamValue">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/waveform_green</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Theme.MedicalSimulator" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorPrimaryDark">@color/background_primary</item>
        <item name="colorAccent">@color/waveform_green</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        
        <item name="colorControlActivated">@color/slider_thumb</item>
        <item name="colorControlHighlight">@color/slider_thumb</item>
    </style>
    <style name="Theme.MedicalSimulator.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@color/background_dialog</item>
        <item name="android:windowIsFloating">true</item>
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorAccent">@color/waveform_green</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="Theme.MedicalSimulator.Fullscreen" parent="Theme.MedicalSimulator">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" ns1:ignore="NewApi">shortEdges</item>
    </style>
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary" ns1:ignore="ResourceCycle">@color/purple_500</item>
    </style>
</resources>